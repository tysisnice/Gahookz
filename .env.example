# Both containers stay on loopback. Nginx should proxy to the production port.
GAHOOKZ_BIND_ADDRESS=127.0.0.1
GAHOOKZ_DEV_PORT=3101
GAHOOKZ_PROD_PORT=3102

# The server limits rooms and media in memory, so keep a firm container cap.
GAHOOKZ_NODE_MEMORY_MB=768
GAHOOKZ_MEMORY_LIMIT=1g
GAHOOKZ_CPU_LIMIT=2.0

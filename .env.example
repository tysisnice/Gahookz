# The Compose project that owns production. compose.yaml declares `name: gahookz`,
# which the development stack also uses, so a host that runs production from its
# own clone must name that project here or a deploy will target the wrong stack.
# COMPOSE_PROJECT_NAME=gahookz-prod

# Both containers stay on loopback. Nginx should proxy to the production port.
GAHOOKZ_BIND_ADDRESS=127.0.0.1
GAHOOKZ_DEV_PORT=3101
GAHOOKZ_PROD_PORT=3102

# The server limits rooms and media in memory, so keep a firm container cap.
GAHOOKZ_NODE_MEMORY_MB=768
GAHOOKZ_MEMORY_LIMIT=1g
GAHOOKZ_CPU_LIMIT=2.0

# Production proxy/security. Keep HTTPS=0 only when accessing Node directly
# over plain local HTTP. TRUST_PROXY must only be enabled behind your own proxy.
GAHOOKZ_TRUST_PROXY=1
GAHOOKZ_HTTPS=1
GAHOOKZ_PUBLIC_ORIGIN=https://play.example.com

# PostgreSQL is required for durable accounts. Use an unsynced secret or secret
# manager in production; do not commit a live connection string.
GAHOOKZ_DATABASE_URL=postgresql://gahookz:replace-me@database.example.com:5432/gahookz
GAHOOKZ_DATABASE_SSL=1
GAHOOKZ_AUTO_MIGRATE=1
GAHOOKZ_REQUIRE_POSTGRES=1
GAHOOKZ_PROD_INSTANCE_ID=prod-1

# Long random bearer used only by the private Prometheus scraper. When blank,
# /api/metrics behaves as not found, which means the service is running with no
# observability at all -- set this on every deployment you intend to watch.
# Generate one with: openssl rand -base64 48
GAHOOKZ_METRICS_TOKEN=

# Create a Web OAuth client and register
# https://play.example.com/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Idle rooms are reaped after this many milliseconds without a live client.
# The default is five minutes; only the expiry regression test lowers it.
# GAHOOKZ_ROOM_EXPIRE_MS=300000

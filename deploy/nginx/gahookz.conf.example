# Room codes are non-secret routing keys. Browser API calls send the code in a
# header and event streams send it as `room`; both select the same authority.
# Add more `server` lines only after every instance uses this configuration.
map $http_x_gahookz_room $gahookz_affinity {
    default $http_x_gahookz_room;
    ""      $arg_room;
}

upstream gahookz_app {
    hash $gahookz_affinity consistent;
    server 127.0.0.1:3102;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name gahookz.com www.gahookz.com;

    client_max_body_size 10m;

    location / {
        proxy_pass http://gahookz_app;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Gahookz-Room $http_x_gahookz_room;
        proxy_set_header Connection "";

        # Gahookz uses long-lived Server-Sent Events for live room state.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1m;
        gzip off;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
}

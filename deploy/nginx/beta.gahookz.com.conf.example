# ------------------------------------------------------------
# beta.gahookz.com  —  public beta, no access list
# ------------------------------------------------------------
#
# Written directly rather than through the Nginx Proxy Manager UI. It mirrors
# the gahookz.com host (6.conf) exactly, including the settings a live game
# depends on: proxy_buffering off, a long read timeout, and Upgrade/Connection
# headers. Without those the event stream is buffered and the game appears to
# freeze.
#
# Deliberately no Access List: being open is the point of a beta.
#
# The filename is non-numeric so it cannot collide with NPM's own numbering.
# NPM does not know this host exists, so it will not appear in the UI and will
# not be managed there. Recreating it in the UI later is safe; delete this file
# at the same time.

map $scheme $hsts_header_beta {
    https   "max-age=63072000; preload";
}

server {
  set $forward_scheme http;
  set $server         "gahookz-beta";
  set $port           3001;

  listen 80;
  listen [::]:80;
  listen 443 ssl;
  listen [::]:443 ssl;

  server_name beta.gahookz.com;

  http2 on;

  # Let's Encrypt SSL
  include conf.d/include/letsencrypt-acme-challenge.conf;
  include conf.d/include/ssl-cache.conf;
  include conf.d/include/ssl-ciphers.conf;
  ssl_certificate /etc/letsencrypt/live/npm-beta/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/npm-beta/privkey.pem;

  # Block Exploits
  include conf.d/include/block-exploits.conf;

  # Force SSL
  set $trust_forwarded_proto "F";
  include conf.d/include/force-ssl.conf;

  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $http_connection;
  proxy_http_version 1.1;

  access_log /data/logs/proxy-host-beta_access.log proxy;
  error_log /data/logs/proxy-host-beta_error.log warn;

  client_max_body_size 10m;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Server-sent events must not be buffered, or the room looks frozen.
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 1h;
  proxy_send_timeout 1m;
  gzip off;

  location / {
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
    proxy_http_version 1.1;

    # Proxy!
    include conf.d/include/proxy.conf;
  }

  # Custom
  include /data/nginx/custom/server_proxy[.]conf;
}
